{
  "name": "@lupinum/better-convex-nuxt",
  "version": "1.0.0-rc.1",
  "description": "Full-featured Convex integration for Nuxt with SSR, real-time subscriptions, and authentication",
  "keywords": [
    "authentication",
    "backend",
    "better-auth",
    "convex",
    "nuxt",
    "nuxt-module",
    "real-time",
    "ssr",
    "vue",
    "vue3",
    "websocket"
  ],
  "homepage": "https://better-convex.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/better-convex/issues"
  },
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/lupinum-dev/better-convex"
  },
  "bin": {
    "better-convex": "./dist/runtime/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "better-auth/client": [
        "./dist/runtime/auth-client/index.d.ts"
      ],
      "better-auth/server": [
        "./dist/runtime/convex-auth/index.d.ts"
      ],
      "better-auth/convex.config": [
        "./dist/runtime/convex-auth/component/convex.config.d.ts"
      ],
      "better-auth/_generated/component.js": [
        "./dist/runtime/convex-auth/component/_generated/component.d.ts"
      ],
      "better-auth/test": [
        "./dist/runtime/convex-auth/test.d.ts"
      ],
      "errors": [
        "./dist/runtime/errors/index.d.ts"
      ],
      "experimental": [
        "./dist/runtime/experimental/index.d.ts"
      ],
      "test": [
        "./dist/runtime/test/index.d.ts"
      ],
      "server": [
        "./dist/runtime/server/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./better-auth/client": {
      "types": "./dist/runtime/auth-client/index.d.ts",
      "import": "./dist/runtime/auth-client/index.js"
    },
    "./better-auth/server": {
      "types": "./dist/runtime/convex-auth/index.d.ts",
      "import": "./dist/runtime/convex-auth/index.js"
    },
    "./better-auth/convex.config": {
      "types": "./dist/runtime/convex-auth/component/convex.config.d.ts",
      "import": "./dist/runtime/convex-auth/component/convex.config.js"
    },
    "./better-auth/_generated/component.js": {
      "types": "./dist/runtime/convex-auth/component/_generated/component.d.ts"
    },
    "./better-auth/test": {
      "types": "./dist/runtime/convex-auth/test.d.ts",
      "import": "./dist/runtime/convex-auth/test.js"
    },
    "./errors": {
      "types": "./dist/runtime/errors/index.d.ts",
      "import": "./dist/runtime/errors/index.js"
    },
    "./experimental": {
      "types": "./dist/runtime/experimental/index.d.ts",
      "import": "./dist/runtime/experimental/index.js"
    },
    "./test": {
      "types": "./dist/runtime/test/index.d.ts",
      "import": "./dist/runtime/test/index.js"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    },
    "./agent-docs": "./dist/agent/AGENTS.md"
  },
  "scripts": {
    "prepack": "node scripts/agent-docs.mjs --check",
    "dev": "pnpm --filter './packages/*' build && nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare --cwd playground --dotenv .env.local && nuxi dev --cwd playground --dotenv .env.local --port 4578",
    "build": "pnpm build:packages && pnpm build:prepared",
    "build:packages": "pnpm --filter './packages/*' build && nuxt-module-build prepare && nuxi build src/runtime/devtools/ui --preset static && nuxt-module-build build",
    "lint": "eslint . && oxfmt --check && node scripts/check-boundaries.mjs && node scripts/lint-changesets.mjs",
    "format": "oxfmt",
    "typecheck": "pnpm --filter './packages/*' build && nuxt-module-build prepare && pnpm typecheck:prepared",
    "test": "nuxt-module-build prepare && pnpm test:prepared",
    "test:packed": "node test/packed/check-packed.mjs && nuxi prepare --cwd test/fixtures/consumer-smoke && nuxi typecheck --cwd test/fixtures/consumer-smoke && nuxi prepare --cwd test/fixtures/missing-convex-api && nuxi typecheck --cwd test/fixtures/missing-convex-api && node test/packed/check-auth-disabled-build-graph.mjs",
    "test:integration": "pnpm build:packages && vitest run --project=integration && node test/integration/check-auth-schema.mjs",
    "test:e2e": "pnpm --filter ./packages/vue build && node scripts/run-e2e.mjs",
    "test:starters": "pnpm build && node test/packed/check-starters.mjs",
    "docs:dev": "pnpm --dir docs install --frozen-lockfile --ignore-scripts && pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs install --frozen-lockfile --ignore-scripts && pnpm --dir docs build",
    "verify": "pnpm lint && pnpm build:packages && pnpm typecheck:prepared && pnpm test:prepared && pnpm build:prepared && pnpm test:packed && pnpm audit --audit-level=high && pnpm --dir docs audit --audit-level=high && pnpm --dir demo audit --audit-level=high",
    "changeset": "changeset",
    "typecheck:prepared": "vue-tsc --noEmit && tsc --noEmit -p src/runtime/server/tsconfig.json && tsc -p test/mcp/tsconfig.json && tsc --noEmit -p packages/functions/tsconfig.json && tsc --noEmit -p packages/agents/tsconfig.json && tsc --noEmit -p test/fixtures/better-auth-local-component/tsconfig.json && tsc --noEmit -p test/fixtures/better-auth-two-factor/tsconfig.json && tsc --noEmit -p test/fixtures/auth-security-plugins/tsconfig.json",
    "test:prepared": "vitest run --project=unit --project=security --project=convex --project=nuxt --project=browser --project=auth-adapter --project=auth-fuzz --project=mcp --project=functions --project=agents",
    "build:prepared": "pnpm docs:build && node scripts/agent-docs.mjs"
  },
  "dependencies": {
    "@lupinum/better-convex-vue": "workspace:*",
    "@nuxt/kit": "4.5.2",
    "convex-helpers": "0.1.114",
    "defu": "^6.1.5",
    "h3": "1.15.11",
    "jiti": "2.7.0",
    "ohash": "^2.0.11"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@better-auth/core": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@edge-runtime/vm": "^5.0.0",
    "@lupinum/better-convex-agents": "workspace:*",
    "@lupinum/better-convex-functions": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "1.0.2",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.11",
    "arktype": "2.2.3",
    "better-auth": "1.7.6",
    "convex": "1.42.2",
    "convex-test": "^0.0.54",
    "eslint": "^10.7.0",
    "happy-dom": "^20.8.9",
    "jose": "6.2.3",
    "nuxt": "4.5.2",
    "oxfmt": "^0.59.0",
    "pkg-pr-new": "0.0.87",
    "playwright": "^1.61.1",
    "publint": "0.3.24",
    "typescript": "~5.9.3",
    "vite": "8.1.5",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "^3.3.7",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@better-auth/core": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "better-auth": "1.7.6",
    "convex": ">=1.42.2 <2",
    "nuxt": ">=4.5.2 <5"
  },
  "peerDependenciesMeta": {
    "@better-auth/core": {
      "optional": true
    },
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
