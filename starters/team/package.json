{
  "name": "better-convex-nuxt-starter-team",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "build": "nuxt build --dotenv .env.local",
    "preview": "nuxt preview --dotenv .env.local",
    "convex:configure": "better-convex convex configure",
    "convex:dev": "better-convex convex dev",
    "convex:codegen": "better-convex convex codegen",
    "convex:local:once": "better-convex convex dev --anonymous --once --typecheck try --typecheck-components",
    "test": "nuxi prepare --dotenv .env.local && vitest run",
    "typecheck": "nuxt typecheck --dotenv .env.local",
    "verify": "pnpm test && pnpm convex:codegen && pnpm typecheck && pnpm build",
    "verify:release": "pnpm verify && pnpm convex:local:once",
    "verify:browser": "node scripts/verify-browser-happy-path.mjs",
    "verify:browser:mobile": "node scripts/verify-browser-happy-path.mjs --mobile",
    "verify:full": "pnpm verify:release && pnpm verify:browser"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@lupinum/better-convex-nuxt": "1.0.0-rc.1",
    "better-auth": "1.7.7",
    "convex": "1.42.2",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@nuxt/schema": "4.6.1",
    "@types/node": "^25.0.0",
    "convex-test": "^0.0.41",
    "playwright": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.18",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
