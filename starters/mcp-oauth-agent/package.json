{
  "name": "better-convex-nuxt-starter-mcp-oauth-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "build": "nuxt build --dotenv .env.local",
    "convex:configure": "nuxi prepare --dotenv .env.local && better-convex convex configure",
    "convex:codegen": "nuxi prepare --dotenv .env.local && better-convex convex codegen",
    "convex:dev": "nuxi prepare --dotenv .env.local && better-convex convex dev",
    "test": "vitest run",
    "typecheck": "nuxt typecheck --dotenv .env.local && tsc -p convex --noEmit",
    "verify": "pnpm test && pnpm convex:codegen && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@lupinum/better-convex-agents": "0.1.0-rc.4",
    "@lupinum/better-convex-functions": "0.1.0-rc.4",
    "@lupinum/better-convex-nuxt": "1.0.0-rc.6",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.12",
    "convex": "1.48.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "convex-test": "^0.0.65",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
