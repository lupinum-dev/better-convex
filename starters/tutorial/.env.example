# Copy to .env.local before the first `pnpm dev`. `pnpm dev` adds the Convex values, and
# `better-convex-nuxt auth init` adds BCN_AUTH_PROXY_IP_SECRET. Never commit .env.local.
SITE_URL=http://localhost:3000
# Required when SITE_URL is not localhost. See the deployment docs.
# BCN_AUTH_TRUSTED_CLIENT_IP_HEADER=
